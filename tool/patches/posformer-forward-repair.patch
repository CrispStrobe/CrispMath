+// Diagnostic-only patch: shared token-input path used by real decode and probe.
+static void prepare_token_input(float * x, int d, const float * word_w, const float * word_b,
+                                const float * position, const float * input_w, const float * input_b) {
+    layernorm(x, d, word_w, word_b);
+    if (position) for (int i = 0; i < d; ++i) x[i] += position[i];
+    layernorm(x, d, input_w, input_b);
+}
+
+extern "C" __attribute__((visibility("default"))) int crispembed_posformer_input_norm_probe(const float * embedding, const float * position,
+    const float * word_w, const float * word_b, const float * input_w, const float * input_b,
+    float * output, int d) {
+    if (!embedding || !position || !word_w || !word_b || !input_w || !input_b || !output ||
+        d < 1 || d > 4096) return 0;
+    memcpy(output, embedding, d * sizeof(float));
+    prepare_token_input(output, d, word_w, word_b, position, input_w, input_b);
+    return 1;
+}
