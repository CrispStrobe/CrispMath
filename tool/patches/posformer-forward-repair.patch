+// Diagnostic ceil-mode pooling: duplicate only missing edge samples.
+// This preserves valid-sample means, including an odd bottom-right corner.
+static ggml_tensor * pf_pool_ceil(ggml_context * g, ggml_tensor * x, enum ggml_op_pool op) {
+    if (x->ne[0] % 2) {
+        ggml_tensor * last = ggml_view_3d(g, x, 1, x->ne[1], x->ne[2],
+                                        x->nb[1], x->nb[2], (x->ne[0] - 1) * x->nb[0]);
+        x = ggml_concat(g, x, last, 0);
+    }
+    if (x->ne[1] % 2) {
+        ggml_tensor * last = ggml_view_3d(g, x, x->ne[0], 1, x->ne[2],
+                                        x->nb[1], x->nb[2], (x->ne[1] - 1) * x->nb[1]);
+        x = ggml_concat(g, x, last, 1);
+    }
+    return ggml_pool_2d(g, x, op, 2, 2, 2, 2, 0, 0);
+}
+
+// The hosted synthetic control exercises the exact helper used by real inference.
+extern "C" __attribute__((visibility("default")))
+int crispembed_posformer_pool_ceil_probe(const float * input, int channels, int height, int width,
+                                        int average, int input_count, float * output, int output_count) {
+    if (!input || !output || channels < 1 || channels > 8 || height < 1 || height > 16 ||
+        width < 1 || width > 16 || (average != 0 && average != 1) ||
+        input_count != channels * height * width ||
+        output_count != channels * ((height + 1) / 2) * ((width + 1) / 2)) return 0;
+    ggml_init_params params = { 1024 * 1024, nullptr, false };
+    ggml_context * g = ggml_init(params);
+    if (!g) return 0;
+    ggml_tensor * pixels = ggml_new_tensor_3d(g, GGML_TYPE_F32, width, height, channels);
+    memcpy(pixels->data, input, input_count * sizeof(float));
+    ggml_tensor * pooled = pf_pool_ceil(g, pixels, average ? GGML_OP_POOL_AVG : GGML_OP_POOL_MAX);
+    ggml_cgraph * graph = ggml_new_graph_custom(g, 64, false);
+    ggml_build_forward_expand(graph, pooled);
+    const bool success = ggml_graph_compute_with_ctx(g, graph, 2) == GGML_STATUS_SUCCESS;
+    if (success) memcpy(output, pooled->data, output_count * sizeof(float));
+    ggml_free(g);
+    return success ? 1 : 0;
+}
