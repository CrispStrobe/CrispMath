{
  "schemaVersion": 1,
  "reference": "Independent pre-observation arithmetic, matrix pivot identities, centered moments and probability formulas, coherent dimensional scales and complete integer-domain proofs. See docs/round10-math-numeric.md.",
  "tasks": [
    {
      "title": "Five-element choice from twelve",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "factorial(12)/(factorial(5)*factorial(7))"
      ],
      "expected": "792",
      "exact": true,
      "id": "round10-numeric-01"
    },
    {
      "title": "Exact reciprocal of terminating-decimal sum",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "1/(0.125+0.2)"
      ],
      "expected": "40/13",
      "exact": true,
      "id": "round10-numeric-02"
    },
    {
      "title": "Mixed triangular pivot determinant",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "det(Matrix([[1,2,3],[0,-2,4],[5,0,1]]))"
      ],
      "expected": "68",
      "exact": true,
      "id": "round10-numeric-03"
    },
    {
      "title": "Rational inverse with determinant two",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "inv(Matrix([[3,2],[5,4]]))"
      ],
      "expected": "Matrix([[2,-1],[-5/2,3/2]])",
      "id": "round10-numeric-04"
    },
    {
      "title": "Rectangular matrix contraction",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "Matrix([[1,-1,2],[0,3,1]])*Matrix([[2,0],[-1,4],[3,-2]])"
      ],
      "expected": "Matrix([[9,-8],[0,10]])",
      "id": "round10-numeric-05"
    },
    {
      "title": "Dependent rows with scaled middle pivot",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "rref(Matrix([[1,3,4],[2,6,8],[0,2,2]]))"
      ],
      "expected": "Matrix([[1,0,1],[0,1,1],[0,0,0]])",
      "id": "round10-numeric-06"
    },
    {
      "title": "Unequal repeated observations",
      "kind": "module",
      "operation": "describe",
      "data": [
        1,
        1,
        4,
        4,
        5
      ],
      "expected": {
        "mean": 3,
        "median": 4,
        "sampleStddev": 1.8708286933869707
      },
      "id": "round10-numeric-07"
    },
    {
      "title": "Tiny symmetric five-point dispersion",
      "kind": "module",
      "operation": "describe",
      "data": [
        1e-100,
        -1e-100,
        0,
        0,
        0
      ],
      "expected": {
        "mean": 0,
        "median": 0,
        "sampleStddev": 7.071067811865476e-101
      },
      "id": "round10-numeric-08"
    },
    {
      "title": "Four-point imperfect increasing regression",
      "kind": "module",
      "operation": "regression",
      "xs": [
        0,
        1,
        2,
        3
      ],
      "ys": [
        1,
        3,
        2,
        4
      ],
      "expected": {
        "slope": 0.8,
        "intercept": 1.3,
        "rSquared": 0.64
      },
      "id": "round10-numeric-09"
    },
    {
      "title": "Three quarter-probability successes",
      "kind": "module",
      "operation": "binomial",
      "n": 8,
      "p": 0.25,
      "k": 3,
      "expected": 0.2076416015625,
      "id": "round10-numeric-10"
    },
    {
      "title": "Translated normal two-sigma lower tail",
      "kind": "module",
      "operation": "normalCdf",
      "mean": -3,
      "stddev": 2,
      "x": -7,
      "expected": 0.02275013194817921,
      "id": "round10-numeric-11"
    },
    {
      "title": "Two-degree t interval ending at root six",
      "kind": "module",
      "operation": "tInterval",
      "df": 2,
      "lower": 0,
      "upper": 2.449489742783178,
      "expected": 0.4330127018922193,
      "id": "round10-numeric-12"
    },
    {
      "title": "Three-bin chi-square imbalance",
      "kind": "module",
      "operation": "chiSquare",
      "observed": [
        12,
        8,
        10
      ],
      "counts": [
        10,
        10,
        10
      ],
      "expected": {
        "statistic": 0.8,
        "df": 2,
        "pValue": 0.6703200460356393
      },
      "id": "round10-numeric-13"
    },
    {
      "title": "Electrical voltage from paired SI prefixes",
      "kind": "module",
      "operation": "unit",
      "expression": "6 kΩ * 2 mA in V",
      "expected": "12 V",
      "id": "round10-numeric-14"
    },
    {
      "title": "Electrical current with kiloohm divisor",
      "kind": "module",
      "operation": "unit",
      "expression": "12 V / 3 kΩ in mA",
      "expected": "4 mA",
      "id": "round10-numeric-15"
    },
    {
      "title": "Pressure-volume work with prefix cancellation",
      "kind": "module",
      "operation": "unit",
      "expression": "2 kPa * 3 L in J",
      "expected": "6 J",
      "id": "round10-numeric-16"
    },
    {
      "title": "Travel speed with both noncoherent units",
      "kind": "module",
      "operation": "unit",
      "expression": "36 km / 2 h in m/s",
      "expected": "5 m/s",
      "id": "round10-numeric-17"
    },
    {
      "title": "Mass density with cubic centimetres",
      "kind": "module",
      "operation": "unit",
      "expression": "5 g / 2 cm³ in kg/m³",
      "expected": "2500 kg/m³",
      "id": "round10-numeric-18"
    },
    {
      "title": "Force-distance work into CGS energy",
      "kind": "module",
      "operation": "unit",
      "expression": "3 N * 4 cm in erg",
      "expected": "1200000 erg",
      "id": "round10-numeric-19"
    },
    {
      "title": "Squared speed as specific energy",
      "kind": "module",
      "operation": "unit",
      "expression": "9 m² / 4 s² in J/kg",
      "expected": "2.25 J/kg",
      "id": "round10-numeric-20"
    },
    {
      "title": "Positive horizontal coordinate on integer circle",
      "kind": "module",
      "operation": "constraint",
      "program": "vars: x, y in -3..3\nx*x+y*y == 5\nx > 0",
      "unordered": true,
      "expected": [
        {
          "x": 1,
          "y": -2
        },
        {
          "x": 1,
          "y": 2
        },
        {
          "x": 2,
          "y": -1
        },
        {
          "x": 2,
          "y": 1
        }
      ],
      "id": "round10-numeric-21"
    },
    {
      "title": "Ordered distinct nonnegative triple of sum four",
      "kind": "module",
      "operation": "constraint",
      "program": "vars: x, y, z in 0..4\nx+y+z == 4\nx < y\ny < z",
      "unordered": true,
      "expected": [
        {
          "x": 0,
          "y": 1,
          "z": 3
        }
      ],
      "id": "round10-numeric-22"
    },
    {
      "title": "Nearest balanced pair under odd sum",
      "kind": "module",
      "operation": "constraintObjective",
      "program": "vars: x, y in 0..5\nx+y == 5\nminimize (x-1)*(x-1)+(y-1)*(y-1)",
      "expected": 5,
      "id": "round10-numeric-23"
    },
    {
      "title": "Shifted product maximization with opposing variables",
      "kind": "module",
      "operation": "constraintObjective",
      "program": "vars: x, y in -2..2\nx+y == 0\nmaximize (x+1)*(y+1)",
      "expected": 1,
      "id": "round10-numeric-24"
    },
    {
      "title": "Exclude negative quadratic root explicitly",
      "kind": "module",
      "operation": "constraint",
      "program": "vars: x in -4..4\nx*x == 4\nx != -2",
      "unordered": true,
      "expected": [
        {
          "x": 2
        }
      ],
      "id": "round10-numeric-25"
    }
  ]
}
