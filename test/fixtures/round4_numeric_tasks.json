{
  "schemaVersion": 1,
  "reference": "Independent arithmetic and dimensional conversion; centered sample statistics and exact line coefficients; binomial support, closed-form Cauchy/t(2) probabilities; matrix algebra and complete finite constraints.",
  "tasks": [
    {
      "id": "round4-numeric-01",
      "title": "Decimal reciprocal square",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "(0.25)^(-2)"
      ],
      "expected": "16",
      "exact": true
    },
    {
      "id": "round4-numeric-02",
      "title": "Negative decimal odd power",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "(-0.5)^3"
      ],
      "expected": "-1/8",
      "exact": true
    },
    {
      "id": "round4-numeric-03",
      "title": "Huge integer shifted remainder",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "(10^20+3)%7"
      ],
      "expected": "5",
      "exact": true
    },
    {
      "id": "round4-numeric-04",
      "title": "Rational base zero exponent",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "(5/7)^0"
      ],
      "expected": "1",
      "exact": true
    },
    {
      "id": "round4-numeric-05",
      "title": "Perfect square root exact quotient",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "sqrt(49)/sqrt(121)"
      ],
      "expected": "7/11",
      "exact": true
    },
    {
      "id": "round4-numeric-06",
      "title": "Euclidean negative remainder six",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "(-20)%6"
      ],
      "expected": "4",
      "exact": true
    },
    {
      "id": "round4-numeric-07",
      "title": "Sparse outlier descriptive sample",
      "kind": "module",
      "operation": "describe",
      "data": [
        1,
        1,
        1,
        9
      ],
      "expected": {
        "mean": 3,
        "median": 1,
        "sampleStddev": 4
      }
    },
    {
      "id": "round4-numeric-08",
      "title": "Centered decimal descriptive sample",
      "kind": "module",
      "operation": "describe",
      "data": [
        -0.5,
        0,
        0.5
      ],
      "expected": {
        "mean": 0,
        "median": 0,
        "sampleStddev": 0.5
      }
    },
    {
      "id": "round4-numeric-09",
      "title": "Regression with large predictor offset",
      "kind": "module",
      "operation": "regression",
      "xs": [
        1000000000,
        1000000001,
        1000000002
      ],
      "ys": [
        1,
        3,
        5
      ],
      "expected": {
        "slope": 2,
        "intercept": -1999999999,
        "rSquared": 1
      }
    },
    {
      "id": "round4-numeric-10",
      "title": "Regression with large response offset",
      "kind": "module",
      "operation": "regression",
      "xs": [
        0,
        1,
        2
      ],
      "ys": [
        1000000000,
        1000000002,
        1000000004
      ],
      "expected": {
        "slope": 2,
        "intercept": 1000000000,
        "rSquared": 1
      }
