{
  "schemaVersion": 1,
  "reference": "Hand derivations frozen before app observation in docs/round10-math-algebra.md. Principal complex branches; ordinary real improper integrals.",
  "tasks": [
    {
      "id": "round10-algebra-01",
      "kind": "engine",
      "title": "Principal logarithm of an imaginary quotient",
      "operation": "evaluate",
      "args": [
        "ln((1+I)/(1-I))"
      ],
      "expected": "pi*I/2"
    },
    {
      "id": "round10-algebra-02",
      "kind": "engine",
      "title": "Principal square root of a nonreal square",
      "operation": "evaluate",
      "args": [
        "sqrt((3-4*I)^2)"
      ],
      "expected": "3-4*I"
    },
    {
      "id": "round10-algebra-03",
      "kind": "engine",
      "title": "Opposite Euler phases sum to a rational",
      "operation": "evaluate",
      "args": [
        "exp(I*pi/3)+exp(-I*pi/3)"
      ],
      "expected": "1"
    },
    {
      "id": "round10-algebra-04",
      "kind": "engine",
      "title": "Conjugation reverses a quotient imaginary component",
      "operation": "evaluate",
      "args": [
        "conjugate((2+I)/(1-3*I))"
      ],
      "expected": "-1/10-7*I/10"
    },
    {
      "id": "round10-algebra-05",
      "kind": "engine",
      "title": "Repeated root with nonreal leading coefficient",
      "operation": "solve",
      "args": [
        "(I-1)*x^2+(2-2*I)*x+(I-1)",
        "x"
      ],
      "expected": "x = 1"
    },
    {
      "id": "round10-algebra-06",
      "kind": "engine",
      "title": "One quotient numerator root survives its original denominator",
      "operation": "solve",
      "args": [
        "(x^2+x-6)/(x^2-4)",
        "x"
      ],
      "expected": "x = -3"
    },
    {
      "id": "round10-algebra-07",
      "kind": "engine",
      "title": "Every complex numerator root is a forbidden source hole",
      "operation": "solve",
      "args": [
        "(x^2+1)^2/(x^2+1)",
        "x"
      ],
      "expected": "x = (no solutions)"
    },
    {
      "id": "round10-algebra-08",
      "kind": "engine",
      "title": "Perfect square factorization with irreducible quadratic factor",
      "operation": "factor",
      "args": [
        "x^4+2*x^2+1"
      ],
      "expected": "(x^2+1)^2",
      "resultPattern": "^(?=.*\\()(?!.*(?:factor|Error)).+$"
    },
    {
      "id": "round10-algebra-09",
      "kind": "engine",
      "title": "Trivariate opposite-sign binomial squares cancel",
      "operation": "expand",
      "args": [
        "(x+y+z)^2-(x+y-z)^2"
      ],
      "expected": "4*x*z+4*y*z",
      "resultPattern": "^(?!.*[()])(?!(?:.*(?:expand|Error))).+$"
    },
    {
      "id": "round10-algebra-10",
      "kind": "engine",
      "title": "Multivariate repeated linear factor cancels",
      "operation": "simplify",
      "args": [
        "(a^2+2*a*b+b^2)/(a+b)"
      ],
      "expected": "a+b",
      "resultPattern": "^(?!.*[/^])(?!(?:.*(?:simplify|Error))).+$"
    },
    {
      "id": "round10-algebra-11",
      "kind": "engine",
      "title": "Cyclic permutation matrix determinant",
      "operation": "evaluate",
      "args": [
        "det(Matrix([[0,1,0],[0,0,1],[1,0,0]]))"
      ],
      "expected": "1"
    },
    {
      "id": "round10-algebra-12",
      "kind": "engine",
      "title": "Length-three Jordan inverse retains second superdiagonal",
      "operation": "evaluate",
      "args": [
        "inv(Matrix([[2,1,0],[0,2,1],[0,0,2]]))"
      ],
      "expected": "Matrix([[1/2,-1/4,1/8],[0,1/2,-1/4],[0,0,1/2]])"
    },
    {
      "id": "round10-algebra-13",
      "kind": "engine",
      "title": "Leading zero column shifts square row reduction pivots",
      "operation": "evaluate",
      "args": [
        "rref(Matrix([[0,1,2],[0,2,4],[0,1,3]]))"
      ],
      "expected": "Matrix([[0,1,0],[0,0,1],[0,0,0]])"
    },
    {
      "id": "round10-algebra-14",
      "kind": "engine",
      "title": "Overdetermined consistent linear equations have a unique solution",
      "operation": "linsolve",
      "args": [
        "x+y+z=6;x-y=0;2*x+z=6;x+2*y+3*z=12",
        "x,y,z"
      ],
      "expected": "x = 2, y = 2, z = 2"
    },
    {
      "id": "round10-algebra-15",
      "kind": "engine",
      "title": "Logarithmic primitive on a regular positive quadratic",
      "operation": "integrate",
      "args": [
        "x/(x^2+4)",
        "x",
        "0",
        "2"
      ],
      "expected": "ln(2)/2"
    },
    {
      "id": "round10-algebra-16",
      "kind": "engine",
      "title": "Upper endpoint logarithm converges by a limiting primitive",
      "operation": "integrate",
      "args": [
        "ln(3-2*x)",
        "x",
        "0",
        "3/2"
      ],
      "expected": "3*(ln(3)-1)/2"
    },
    {
      "id": "round10-algebra-17",
      "kind": "engine",
      "title": "Logarithmic square divided by x has divergent endpoint",
      "operation": "integrate",
      "args": [
        "ln(x)^2/x",
        "x",
        "0",
        "1"
      ],
      "errorContains": "divergent"
    },
    {
      "id": "round10-algebra-18",
      "kind": "engine",
      "title": "Irrational real poles outside the integration interval",
      "operation": "integrate",
      "args": [
        "1/(x^2-7)",
        "x",
        "-1",
        "1"
      ],
      "expected": "ln((sqrt(7)-1)/(sqrt(7)+1))/sqrt(7)"
    },
    {
      "id": "round10-algebra-19",
      "kind": "module",
      "title": "Even polynomial inside absolute value stays differentiable",
      "operation": "differentiateAt",
      "expression": "abs((x^2-1)^2)",
      "variable": "x",
      "point": "1",
      "expected": "0"
    },
    {
      "id": "round10-algebra-20",
      "kind": "module",
      "title": "Product with smooth negative absolute branch differentiates",
      "operation": "differentiateAt",
      "expression": "x*abs(x^2-4)",
      "variable": "x",
      "point": "0",
      "expected": "4"
    },
    {
      "id": "round10-algebra-21",
      "kind": "engine",
      "title": "Absolute quadratic Taylor branch at a rational center",
      "operation": "series",
      "args": [
        "abs(x^2-x)",
        "x",
        "1/2",
        "3"
      ],
      "expected": "x-x^2",
      "resultPattern": "^(?!.*(?:abs|series|taylor|Derivative|Subs)).+$"
    },
    {
      "id": "round10-algebra-22",
      "kind": "engine",
      "title": "Fifth-order absolute zero supports four center derivatives",
      "operation": "series",
      "args": [
        "abs((x-2)^5)",
        "x",
        "2",
        "5"
      ],
      "expected": "0",
      "resultPattern": "^(?!.*(?:abs|series|taylor|Derivative|Subs)).+$"
    },
    {
      "id": "round10-algebra-23",
      "kind": "engine",
      "title": "Scaled radical subtraction has a finite infinity limit",
      "operation": "limit",
      "args": [
        "sqrt(4*x^2+x)-2*x",
        "x",
        "oo"
      ],
      "expected": "1/4"
    },
    {
      "id": "round10-algebra-24",
      "kind": "engine",
      "title": "Triple-angle identity resolves a cubic vanishing quotient",
      "operation": "limit",
      "args": [
        "(sin(3*x)-3*sin(x))/x^3",
        "x",
        "0"
      ],
      "expected": "-4"
    },
    {
      "id": "round10-algebra-25",
      "kind": "engine",
      "title": "Square root of a square is real absolute value in a limit",
      "operation": "limit",
      "args": [
        "x/sqrt(x^2)",
        "x",
        "0"
      ],
      "errorContains": "left and right limits differ"
    }
  ]
}
