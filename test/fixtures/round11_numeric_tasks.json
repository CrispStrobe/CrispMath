      "id": "round11-numeric-01",
      "title": "Eight-element subsets of seventeen",
      "kind": "engine",
      "operation": "evaluate",
      "args": [
        "factorial(17)/(factorial(8)*factorial(9))"
      ],
      "exact": true,
      "expected": "24310"
    },
    {
      "id": "round11-numeric-02",
      "title": "Exact small-decimal quotient",
      "kind": "engine",
