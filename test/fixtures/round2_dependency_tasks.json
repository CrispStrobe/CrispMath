        null,
        "^-?\\d+\\.\\d+(?:[eE][+-]?\\d+)?$"
      ],
      "normalizeRealScalars": true
    },
    {
      "id": "round2-dependency-03",
      "kind": "document",
      "title": "Literal decimal coefficients remain exactly rational",
      "lines": [
        "a=0.2",
        "f(t)=a*t",
        "f(0.3)"
      ],
      "expected": [
        "1/5",
        "t/5",
        "3/50"
      ],
      "expectedAccuracy": [
