        ],
        [
          "unknown",
          "approximate"
        ]
      ],
      "expectedResultPatterns": [
        null,
        null,
        null,
        "^-?\\d+\\.\\d+(?:[eE][+-]?\\d+)?$"
      ],
      "normalizeRealScalars": true
    },
    {
