{
  "schemaVersion": 1,
  "reference": "Independent substitution, reactive dependency arithmetic and elementary real domains, drafted before comparison with prior fixtures.",
  "tasks": [
    {
      "kind": "document",
      "title": "Diamond dependency recomputes both branches",
      "lines": [
        "a=2",
        "b=a+3",
        "c=a^2",
        "b+c"
      ],
      "expected": [
        "4",
        "7",
        "16",
        "23"
      ],
      "edit": {
        "index": 0,
        "source": "a=4"
      },
      "id": "round2-workflow-01"
    },
    {
      "kind": "document",
      "title": "Forward reference resolves before its definition",
      "lines": [
        "a=b+1",
        "b=8",
        "a*b"
      ],
      "expected": [
        "9",
        "8",
        "72"
      ],
      "id": "round2-workflow-02"
    },
    {
      "kind": "document",
      "title": "Function argument shadows document variable",
      "lines": [
        "t=100",
        "f(t)=t^2+1",
        "f(3)+t"
      ],
      "expected": [
        "100",
        "t^2+1",
        "110"
      ],
      "id": "round2-workflow-03"
    },
    {
      "kind": "document",
      "title": "Nested user function composition",
      "lines": [
        "f(u)=u^2+u",
        "g(v)=f(v-1)",
        "g(-2)"
      ],
      "expected": [
        "u^2+u",
        "(v-1)^2+v-1",
        "6"
      ],
      "id": "round2-workflow-04"
    },
    {
      "kind": "document",
      "title": "Two argument function",
      "lines": [
        "f(x,y)=x^2+2*x*y+y^2",
        "f(3,-5)"
      ],
      "expected": [
        "x^2+2*x*y+y^2",
        "4"
      ],
      "id": "round2-workflow-05"
    },
    {
      "kind": "document",
      "title": "Function coefficient edit cascades",
      "lines": [
        "a=3/5",
        "f(z)=a*z+1",
        "g(w)=f(f(w))",
        "g(10)"
      ],
      "expected": [
        "2/5",
        "2*z/5+1",
        "2*(2*w/5+1)/5+1",
        "3"
      ],
      "edit": {
        "index": 0,
        "source": "a=2/5"
      },
      "id": "round2-workflow-06"
    },
    {
      "kind": "document",
      "title": "Zero coefficient remains valid definition",
      "lines": [
        "a=0",
        "f(u)=a*u+7",
        "f(1000)"
      ],
      "expected": [
        "0",
        "7",
        "7"
      ],
      "id": "round2-workflow-07"
    },
    {
      "kind": "document",
      "title": "Exact decimal coefficient through dependent division",
      "lines": [
        "p=0.2",
        "q=p/3",
        "q*15"
      ],
      "expected": [
        "1/5",
        "1/15",
        "1"
      ],
      "id": "round2-workflow-08"
    },
    {
      "kind": "document",
      "title": "Cancelled denominator after parameter substitution",
      "lines": [
        "a=2",
        "f(t)=(t^2-a^2)/(t-a)",
        "f(3)"
      ],
      "expected": [
        "2",
        "(t^2-4)/(t-2)",
        "5"
      ],
      "id": "round2-workflow-09"
    },
    {
      "kind": "document",
      "title": "Two independent names survive parameter edit",
      "lines": [
        "a=2",
        "b=3",
        "f(t)=a*t+b",
        "f(-4)"
      ],
      "expected": [
        "2",
        "-7",
        "2*t-7",
        "-15"
      ],
      "edit": {
        "index": 1,
        "source": "b=-7"
