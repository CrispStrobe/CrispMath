{
  "schemaVersion": 1,
  "reference": "Independent hand derivations before prior-corpus/app inspection in docs/round9-math-algebra.md. Principal complex branches; real ordinary improper integrals; no principal-value substitution.",
  "tasks": [
    {
      "id": "round9-algebra-01",
      "kind": "engine",
      "title": "Principal log addition keeps both negative-axis winding contributions",
      "operation": "evaluate",
      "args": [
        "ln(-2)+ln(-3)-ln(6)"
      ],
      "expected": "2*pi*I"
    },
    {
      "id": "round9-algebra-02",
      "kind": "engine",
      "title": "Complex reciprocal preserves the negative imaginary sign",
      "operation": "evaluate",
      "args": [
        "(3+4*I)^(-1)"
      ],
      "expected": "3/25-4*I/25"
    },
    {
      "id": "round9-algebra-03",
      "kind": "engine",
      "title": "Conjugate reciprocal of a complex square",
      "operation": "evaluate",
      "args": [
        "conjugate(1/(1+2*I)^2)"
      ],
      "expected": "-3/25+4*I/25"
    },
    {
      "id": "round9-algebra-04",
      "kind": "engine",
      "title": "Opposite principal square-root phases cancel",
      "operation": "evaluate",
      "args": [
        "sqrt(-I)*sqrt(I)"
      ],
      "expected": "1"
    },
    {
      "id": "round9-algebra-05",
      "kind": "engine",
      "title": "Principal rational power retains its upper-half-plane branch",
      "operation": "evaluate",
      "args": [
        "(-1)^(2/3)"
      ],
      "expected": "-1/2+sqrt(3)*I/2"
    },
    {
      "id": "round9-algebra-06",
      "kind": "engine",
      "title": "Nonmonic Gaussian quadratic verifies Vieta sum and product",
      "operation": "solve",
      "args": [
        "(1+I)*x^2+(-2+I)*x+(1-2*I)",
        "x"
      ],
      "expected": "x = {1,-1/2-3*I/2}"
    },
    {
      "id": "round9-algebra-07",
      "kind": "engine",
      "title": "Repeated forbidden source root loses every multiplicity",
      "operation": "solve",
      "args": [
        "(x^2-1)^3/(x^2+2*x+1)",
        "x"
      ],
      "expected": "x = 1"
    },
    {
      "id": "round9-algebra-08",
      "kind": "engine",
      "title": "Rational equation with nonzero right-hand side retains legitimate roots",
      "operation": "solve",
      "args": [
        "x^2/(x^2+1)=1/2",
        "x"
      ],
      "expected": "x = {-1,1}"
    },
    {
      "id": "round9-algebra-09",
      "kind": "engine",
      "title": "Every putative quotient-zero solution is a source hole",
      "operation": "solve",
      "args": [
        "(x-1)/(x-1)",
        "x"
      ],
      "expected": "x = (no solutions)"
    },
    {
      "id": "round9-algebra-10",
      "kind": "engine",
      "title": "Fourth logarithmic moment with affine scaling",
      "operation": "integrate",
      "args": [
        "ln(2*x)^4",
        "x",
        "0",
        "1/2"
      ],
      "expected": "12"
    },
    {
      "id": "round9-algebra-11",
      "kind": "engine",
      "title": "Convergent inverse square root at the upper endpoint",
      "operation": "integrate",
      "args": [
        "1/sqrt(1-x)",
        "x",
        "0",
        "1"
      ],
      "expected": "2"
    },
    {
      "id": "round9-algebra-12",
      "kind": "engine",
      "title": "Two cancelled holes leave an odd integrand extension",
      "operation": "integrate",
      "args": [
        "(x^3-x)/(x^2-1)",
        "x",
        "-2",
        "2"
      ],
      "expected": "0"
    },
    {
      "id": "round9-algebra-13",
      "kind": "engine",
      "title": "Repeated irrational pole is an ordinary divergence",
      "operation": "integrate",
      "args": [
        "1/(x^2-2)^2",
        "x",
        "0",
        "2"
      ],
      "errorContains": "divergent pole"
    },
    {
      "id": "round9-algebra-14",
      "kind": "module",
      "title": "Even shifted absolute root has zero derivative",
      "operation": "differentiateAt",
      "expression": "abs(x^2-4*x+4)",
      "variable": "x",
      "point": "2",
      "expected": "0"
    },
    {
      "id": "round9-algebra-15",
      "kind": "module",
      "title": "Outer double zero suppresses an absolute cusp",
      "operation": "differentiateAt",
      "expression": "(x+1)^2*abs(x+1)",
      "variable": "x",
      "point": "-1",
      "expected": "0"
    },
    {
      "id": "round9-algebra-16",
      "kind": "module",
      "title": "Positive local absolute branch keeps derivative sign",
      "operation": "differentiateAt",
      "expression": "abs(x^2-4)",
      "variable": "x",
      "point": "3",
      "expected": "6"
    },
    {
      "id": "round9-algebra-17",
      "kind": "engine",
      "title": "Cubic absolute root supports a second-order Taylor polynomial",
      "operation": "series",
      "args": [
        "abs((x+1)^3)",
        "x",
        "-1",
        "3"
      ],
      "expected": "0",
      "resultPattern": "^(?!.*(?:abs|series|taylor|Derivative|Subs|exp)).+$"
    },
    {
      "id": "round9-algebra-18",
      "kind": "engine",
      "title": "Next Taylor term exposes a nonexistent cubic derivative",
      "operation": "series",
      "args": [
        "abs((x+1)^3)",
        "x",
        "-1",
        "4"
      ],
      "errorContains": "does not exist"
    },
    {
      "id": "round9-algebra-19",
      "kind": "engine",
      "title": "Transcendental Taylor center with exact exponential value",
      "operation": "series",
      "args": [
        "exp(x)",
        "x",
        "ln(2)",
        "3"
      ],
      "expected": "2+2*(x-ln(2))+(x-ln(2))^2",
      "resultPattern": "^(?!.*(?:series|taylor|Derivative|Subs|exp\\s*\\(\\s*x\\s*\\))).+$"
    },
    {
      "id": "round9-algebra-20",
      "kind": "engine",
      "title": "Negative-infinity radical cancellation written as addition",
      "operation": "limit",
      "args": [
        "sqrt(4*x^2-12*x+5)+2*x",
        "x",
        "-oo"
      ],
      "expected": "3"
    },
    {
      "id": "round9-algebra-21",
      "kind": "engine",
      "title": "Shifted oscillation has a quadratic vanishing envelope",
      "operation": "limit",
      "args": [
        "(x-3)^2*sin(1/(x-3))",
        "x",
        "3"
      ],
      "expected": "0"
    },
    {
      "id": "round9-algebra-22",
      "kind": "engine",
      "title": "Logarithmic composition with a vanishing quadratic argument",
      "operation": "limit",
      "args": [
        "ln(1+x^2)/x^2",
        "x",
        "0"
      ],
      "expected": "1"
    },
    {
      "id": "round9-algebra-23",
      "kind": "engine",
      "title": "Rectangular reduction pivots past a leading zero column",
      "operation": "evaluate",
      "args": [
        "rref(Matrix([[0,1,2,3],[0,2,4,6],[1,0,1,2]]))"
      ],
      "expected": "Matrix([[1,0,1,2],[0,1,2,3],[0,0,0,0]])"
    },
    {
      "id": "round9-algebra-24",
      "kind": "engine",
      "title": "Odd-dimensional skew-symmetric matrix is singular",
      "operation": "evaluate",
      "args": [
        "det(Matrix([[0,2,-3],[-2,0,4],[3,-4,0]]))"
      ],
      "expected": "0"
    },
    {
      "id": "round9-algebra-25",
      "kind": "engine",
      "title": "Unimodular inverse has exact integer entries",
      "operation": "evaluate",
      "args": [
        "inv(Matrix([[1,2],[3,7]]))"
      ],
      "expected": "Matrix([[7,-2],[-3,1]])"
    }
  ]
}
